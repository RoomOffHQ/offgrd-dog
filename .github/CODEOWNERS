# usernames/teams once the project has actual maintainers.

# Default: any core maintainer can review
*                                   @offgrd-dog/maintainers

# Windows API / unsafe-code-adjacent: higher-trust review required
/crates/offgrd-cli/src/platform/    @offgrd-dog/windows-api-reviewers
/crates/offgrd-cli/src/etw_collector.rs  @offgrd-dog/windows-api-reviewers

